\RequirePackage{setspace}
\RequirePackage{xkeyval}
\RequirePackage{ifthen}

% I'm opening this up to future expansion, e.g. choosing your own title
% format, outside of the one I've made and the LaTeX style.

% You need to define \@QuetzalTitleFormat before changing it, since defining
% it in the package option leads to some pretty screwy results---it will just
% straight up *not* define the macro, for some reason.
\newcommand{\@QuetzalTitleFormat}{regular}

\DeclareOptionX{style}[regular]{%
    \renewcommand\@QuetzalTitleFormat{#1}
}
\ProcessOptionsX\relax

% Consider making this a switch statement in the future.
\ifthenelse{\not\equal{\@QuetzalTitleFormat}{tex}}{
    \input{\packageDir/titleformat}
}

\endinput
