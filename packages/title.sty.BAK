\makeatletter
\def\@maketitle{%
  \newpage
  \null
  \vskip 2em%
  \begin{flushleft}%
   \let \footnote \thanks
    {\LARGE \titleType \@title \par}%
    \vskip 0.5em%
  \end{flushleft}
  \begin{flushright}
    {\large
      \lineskip .5em%
      \begin{tabular}[t]{r}%
        \noindent \textsf \@author \\
	\textsf \@date
      \end{tabular}\par}%
    %\vskip 1em%
    %{\large \textsf \@date}%
  \end{flushright}%
  \par
  \vskip 1.5em}
\makeatother
