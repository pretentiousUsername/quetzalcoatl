	keywords = {Quantitative Biology - Neurons and Cognition, Computer Science - Information Theory, Mathematics - Information Theory},
	file = {Preprint PDF:/home/pines/Zotero/storage/Y9U4G69U/Effenberger - 2013 - A primer on information theory, with applications to neuroscience.pdf:application/pdf;Snapshot:/home/pines/Zotero/storage/DLMST8K7/1304.html:text/html},
}

